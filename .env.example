# ========================================================
# SellerDesk AI - 本地 AI 代理服务配置文件 (.env)
# ========================================================
# 复制本文件为 .env：cp .env.example .env
# 注意：.env 文件已被 .gitignore 忽略，绝不会被提交到代码仓库！

# 1. DeepSeek API Key (必填，向 https://platform.deepseek.com 申请)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 2. DeepSeek API Base URL (可选，默认为官方地址)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 3. DeepSeek 模型名称 (默认为 deepseek-flash)
# 推荐使用 deepseek-flash（非思考模式，超低延迟、低成本客服对话测试）
# 亦可选用: deepseek-chat (DeepSeek-V3)
DEEPSEEK_MODEL=deepseek-flash

# 4. 本地代理服务端口 (可选，默认为 3001)
AI_SERVER_PORT=3001
