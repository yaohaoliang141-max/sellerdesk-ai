# ============================================================
# SellerDesk AI - 本地 AI 服务环境变量配置模板
# ============================================================
#
# 【安全提示】
# 1. 复制本文件重命名为 `.env`（即创建并编辑本地 `.env` 文件）。
# 2. 将你的 DeepSeek API Key 填入下方的 DEEPSEEK_API_KEY。
# 3. 本项目已将 `.env` 添加至 `.gitignore`，绝对不会将密钥提交至 GitHub。
# 4. 请勿将你的真实 API Key 发送到任何聊天窗口或公开仓库中。
#

# DeepSeek 官方 API 密钥 (必填，格式形如 sk-xxxxxxxxxxxxxxxxxxxxxxxx)
DEEPSEEK_API_KEY=

# DeepSeek 官方 API Base URL (默认即可)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 调用模型名称 (官方推荐默认 deepseek-chat，也可填写 deepseek-flash 或 deepseek-reasoner)
DEEPSEEK_MODEL=deepseek-chat

# 本地服务监听端口 (仅监听 127.0.0.1，安全本地访问)
AI_SERVER_PORT=3001
